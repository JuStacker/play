  "version": "0.2.0",
  "configurations": [
    {
      "name": "Yarn log",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["log"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true
    },
    {
      "name": "Yarn main",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "yarn",
